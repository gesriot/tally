// Контурные значки списков, областей и проектов.

import { Theme } from "theme.slint";
import { Icon, Mark } from "types.slint";

export component Star inherits Path {
    in property <color> color: Theme.star;
    viewbox-width: 20;
    viewbox-height: 20;
    fill: color;
    commands: "M 10 1.5 L 12.6 7.1 L 18.6 7.6 L 14 11.6 L 15.4 17.6 L 10 14.4 L 4.6 17.6 L 6 11.6 L 1.4 7.6 L 7.4 7.1 Z";
}

export component Flag inherits Path {
    in property <color> color: Theme.text-muted;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: color;
    stroke-width: 1.6px;
    fill: transparent;
    commands: "M 4 18 L 4 2.5 L 15.5 2.5 L 13 6.5 L 15.5 10.5 L 4 10.5";
}

export component Check inherits Path {
    in property <color> color: Theme.mark-text;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: color;
    stroke-width: 2px;
    fill: transparent;
    commands: "M 4.5 10.5 L 8.5 14.5 L 15.5 5.5";
}

export component Cross inherits Path {
    in property <color> color: Theme.mark-text;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: color;
    stroke-width: 2px;
    fill: transparent;
    commands: "M 5.5 5.5 L 14.5 14.5 M 14.5 5.5 L 5.5 14.5";
}

export component Moon inherits Path {
    in property <color> color: Theme.evening;
    viewbox-width: 20;
    viewbox-height: 20;
    fill: color;
    commands: "M 13 2 A 8 8 0 1 0 18 13 A 6.5 6.5 0 0 1 13 2 Z";
}

component ProjectRing inherits Rectangle {
    in property <float> progress;
    in property <color> tint;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke-width: Theme.project-ring-stroke;
        stroke: root.progress >= 1 ? root.tint : root.tint.with-alpha(0.4);
        fill: transparent;
        commands: "M 10 2.2 A 7.8 7.8 0 1 1 10 17.8 A 7.8 7.8 0 1 1 10 2.2 Z";
    }
    if root.progress > 0 && root.progress < 1: Path {
        property <angle> angle: root.progress * 360deg;
        width: parent.width;
        height: parent.height;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke-width: Theme.project-ring-stroke;
        stroke: root.tint;
        fill: transparent;

        MoveTo { x: 10; y: 2.2; }
        ArcTo {
            radius-x: 7.8;
            radius-y: 7.8;
            x: 10 + 7.8 * sin(angle);
            y: 10 - 7.8 * cos(angle);
            sweep: true;
            large-arc: root.progress > 0.5;
        }
    }
}

// Значок списка, области или проекта.
export component Glyph inherits Rectangle {
    in property <Icon> icon;
    in property <float> progress;
    in property <Mark> mark: Mark.open;
    in property <length> size: Theme.icon;
    width: size;
    height: size;

    property <color> tint: icon == Icon.inbox ? Theme.icon-inbox
        : icon == Icon.today ? Theme.icon-today
        : icon == Icon.upcoming ? Theme.icon-upcoming
        : icon == Icon.anytime ? Theme.icon-anytime
        : icon == Icon.someday ? Theme.icon-someday
        : icon == Icon.logbook ? Theme.icon-logbook
        : icon == Icon.trash ? Theme.icon-trash
        : icon == Icon.area ? Theme.icon-area
        : Theme.icon-project;

    if icon != Icon.project && icon != Icon.today: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: root.tint;
        stroke-width: 1.55px;
        fill: transparent;
        commands: icon == Icon.inbox ? "M 2.5 11 L 5.2 4 L 14.8 4 L 17.5 11 L 17.5 16 L 2.5 16 Z M 2.5 11 L 7 11 L 8.2 13 L 11.8 13 L 13 11 L 17.5 11"
            : icon == Icon.upcoming ? "M 3.2 4.8 L 16.8 4.8 Q 17.5 4.8 17.5 5.5 L 17.5 16 Q 17.5 17 16.5 17 L 3.5 17 Q 2.5 17 2.5 16 L 2.5 5.5 Q 2.5 4.8 3.2 4.8 Z M 6.5 2.7 L 6.5 7 M 13.5 2.7 L 13.5 7 M 3 9.2 L 17 9.2 M 6.5 13 L 9 13"
            : icon == Icon.anytime ? "M 10 2.7 A 7.3 7.3 0 1 1 10 17.3 A 7.3 7.3 0 1 1 10 2.7 Z M 10 5.8 L 10 10 L 13.3 11.9"
            : icon == Icon.someday ? "M 2.7 7 L 17.3 7 L 16 3.5 L 4 3.5 Z M 3.7 7 L 3.7 16.7 L 16.3 16.7 L 16.3 7 M 7.5 10.5 L 12.5 10.5"
            : icon == Icon.logbook ? "M 5 2.8 L 16 2.8 L 16 16.8 L 5 16.8 Q 3.4 16.8 3.4 15 L 3.4 4.6 Q 3.4 2.8 5 2.8 Z M 7 2.8 L 7 16.8 M 9 10 L 10.5 11.5 L 13.6 8.2"
            : icon == Icon.trash ? "M 2.8 5.7 L 17.2 5.7 M 7 5.7 L 7 3.1 L 13 3.1 L 13 5.7 M 4.6 6 L 5.5 17 L 14.5 17 L 15.4 6 M 8 9 L 8.3 14.5 M 12 9 L 11.7 14.5"
            : "M 3 5 L 8 5 L 10 7 L 17 7 L 17 16 L 3 16 Z M 3 5 L 3 3.5 L 9 3.5";
    }
    if icon == Icon.today: Star {
        width: parent.width;
        height: parent.height;
        color: root.tint;
    }
    if icon == Icon.project && mark == Mark.open: ProjectRing {
        width: parent.width;
        height: parent.height;
        progress: root.progress;
        tint: root.tint;
    }
    if icon == Icon.project && mark != Mark.open: Rectangle {
        width: parent.width * 0.84;
        height: parent.height * 0.84;
        border-radius: self.width / 2;
        background: root.mark == Mark.completed ? Theme.icon-logbook : Theme.checkbox-canceled;
        if root.mark == Mark.completed: Check { width: parent.width; height: parent.height; }
        if root.mark == Mark.canceled: Cross { width: parent.width; height: parent.height; }
    }
}
